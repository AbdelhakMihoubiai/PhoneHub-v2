# --- Turso (cloud SQLite) — required for Vercel/hosting, optional for local ---
# Create: turso db create phonehub
# URL:    turso db show phonehub --url
# Token:  turso db tokens create phonehub
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Provider keys (optional) ---
# GSMArena unofficial community API base (optional, self-host or mirror)
GSMARENA_API_BASE=

# SerpApi key for search-based research (optional; falls back to DuckDuckGo HTML)
SERPAPI_KEY=

# Generic web research settings
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_MAX_PAGES=3

# Cache TTLs in hours (defaults shown)
TTL_SPECS_HOURS=168
TTL_BENCHMARK_HOURS=168
TTL_PRICE_HOURS=12
TTL_RELEASE_HOURS=720
